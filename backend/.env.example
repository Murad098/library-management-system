# Copy to .env and fill in. Never commit real credentials.

MONGO_URI=
PORT=5000
ADMIN_EMAIL=muradkhankakar33@gmail.com
ADMIN_PASSWORD=
JWT_SECRET=

# --- Email delivery for the Admin password-reset OTP -------------------------
# The Admin "Forgot Password" flow sends a 6-digit code to ADMIN_EMAIL through
# this SMTP account. Any transactional email provider works; the values below
# are for a Google account using an App Password.
#
# Gmail / Google Workspace:
#   1. Enable 2-Step Verification on the account.
#   2. Google Account -> Security -> App passwords -> create one.
#   3. Use the 16-character value as SMTP_PASS (spaces are fine).
#      SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_SECURE=false
#
# Other providers (use the SMTP credentials they give you):
#   Brevo:    smtp-relay.brevo.com   port 587
#   SendGrid: smtp.sendgrid.net      port 587   user "apikey", pass = API key
#   Resend:   smtp.resend.com        port 587   user "resend", pass = API key
#   Mailgun:  smtp.mailgun.org       port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be an address the provider allows you to send from.
MAIL_FROM=LibreDesk <muradkhankakar33@gmail.com>
